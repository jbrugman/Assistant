# Kopieer dit bestand naar `application.config` naast de native executable
# om waarden uit `assistant.properties` lokaal te overschrijven.

# Voorbeeldprofiel: verhalenverteller
# Deze waarden maken antwoorden creatiever en minder strak dan voor code-assistentie.

# Ander model voor runtime
model.chat=google/gemma-4-12b-qat
model.validator=google/gemma-4-12b-qat

# Meer variatie en fantasie in woordkeuze en verhaallijnen
chat.temperature=1.15

# Laat het model uit een bredere kansverdeling kiezen
chat.topP=0.97
chat.topK=80

# Minder snel afkappen naar alleen de meest veilige token-kandidaten
chat.minP=0.02

# Iets minder streng tegen herhaling, zodat ritme en verteltoon makkelijker terugkomen
chat.repeatPenalty=1.01

# Validator juist streng en stabiel houden
validation.temperature=0.0
validation.topP=0.05

# Kortere timeouts op deze machine
timeout.chatSeconds=120
timeout.validationSeconds=45

# Custom blokkademelding
response.validationFailClosedMessage=Ja zeg... dat gaat zelfs ons iets te ver schat, probeer maar even iets anders.

# Voorbeeld van relatieve paden:
# deze worden bij `application.config` relatief opgelost ten opzichte van
# de map waar de native executable staat.
# file.systemPrompt=systemprompt.md
# file.rules=rules.md
