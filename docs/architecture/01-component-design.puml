@startuml
title Component Design - Storyteller

top to bottom direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam ranksep 45
skinparam nodesep 30

skinparam package {
  BorderColor #4B5563
  FontColor #111827
  BackgroundColor #F9FAFB
}

skinparam component {
  BorderColor #6B7280
  FontColor #111827
  BackgroundColor #FFFFFF
}

skinparam database {
  BorderColor #6B7280
  FontColor #111827
  BackgroundColor #FFFFFF
}

package "CLI Adapter\nnl.llm.storyteller.cli" #E0F2FE {
  [AssistantApp]
  [TerminalStoryteller]
  [TerminalRenderer]
  [ClipboardImageReader]
}

package "Storyteller Core\nnl.llm.storyteller.core" #DCFCE7 {
  [ApplicationFactory]
  [AppConfigLoader]
  [AppConfig]
}

package "Story Orchestration\nnl.llm.storyteller.core.service" #DCFCE7 {
  [StorySessionService]
  [PromptAssemblyService]
  [StoryExportService]
  [ResponseGuard]
  [TurnManager]
}

package "Prompting" #FEF3C7 {
  [Prompt Builders]
  [PromptResourceLoader]
  [PromptTemplateService]
}

package "State & Memory" #FCE7F3 {
  [HistoryStore]
  [TurnStateStore]
  [DerivedMemoryManager]
  [DerivedMemoryTaskQueue]
  [SummaryManager]
  [RecentSummaryManager]
  [CanonicalStateManager]
}

package "Graph Services\nnl.llm.storyteller.core.graph.service" #EDE9FE {
  [KnowledgeGraphService]
  [ReadOnlyKnowledgeGraphService]
  [KnowledgeGraphInitializer]
  [KnowledgeGraphGenerator]
  [KnowledgeGraphFillService]
  [KnowledgeGraphManagementService]
}

package "Turn-based Graph\nnl.llm.storyteller.core.graph.turnbasedservice" #F3E8FF {
  [TurnBasedKnowledgeGraphService]
}

package "Graph Domain & Persistence\nnl.llm.storyteller.core.graph" #EDE9FE {
  [KnowledgeGraphSnapshot]
  [KnowledgeGraphValidator]
  [PredicateCatalog]
  [KnowledgeGraphStore]
  [Graph Entities / Facts / Sources]
}

package "Validation & Backend" #DBEAFE {
  [ValidationClient]
  [ValidationDecisionParser]
  [ResponseSanitizer]
  [ResilientChatClient]
  [LlmBackendGuard]
  [OpenAiCompatibleHttpClient]
  [ManagedLlamaServer]
  [ManagedMlxServer]
}

package "Model Records" #F3F4F6 {
  [Message / HistoryState]
  [Prompt Input Records]
  [ValidationOutcome]
  [TurnState / TurnRuleDecision / GameModeDefinition]
}

database "systemprompts/" as SystemPrompts
database "memory/" as MemoryFiles
database "GGUF model" as GgufModel
database "MLX model" as MlxModel

together {
  [AssistantApp]
  [ApplicationFactory]
  [TerminalStoryteller]
  [TerminalRenderer]
  [StorySessionService]
  [StoryExportService]
}

together {
  [PromptAssemblyService]
  [ResponseGuard]
  [TurnManager]
}

together {
  [SummaryManager]
  [RecentSummaryManager]
  [CanonicalStateManager]
}

[AssistantApp] --> [ApplicationFactory]
[AssistantApp] --> [TerminalStoryteller]
[ApplicationFactory] --> [AppConfigLoader]
[ApplicationFactory] --> [StorySessionService]
[ApplicationFactory] --> [StoryExportService]
[ApplicationFactory] --> [ManagedLlamaServer] : optional start / close
[ApplicationFactory] --> [ManagedMlxServer] : optional start / close
[TerminalStoryteller] --> [StorySessionService]
[TerminalStoryteller] --> [StoryExportService]
[TerminalStoryteller] --> [TerminalRenderer]
[TerminalStoryteller] --> [ClipboardImageReader] : /image
[TerminalStoryteller] --> [KnowledgeGraphService] : /graph
[TerminalStoryteller] --> [KnowledgeGraphInitializer] : /graph -generate
[TerminalStoryteller] --> [KnowledgeGraphFillService] : /graph -fill
[TerminalStoryteller] --> [KnowledgeGraphManagementService] : /graph -reset

[AppConfigLoader] --> [AppConfig]
[AppConfigLoader] --> SystemPrompts : load defaults and overrides

[StorySessionService] --> [PromptAssemblyService]
[StorySessionService] --> [ResponseGuard]
[StorySessionService] --> [HistoryStore]
[StorySessionService] --> [SummaryManager]
[StorySessionService] --> [RecentSummaryManager]
[StorySessionService] --> [CanonicalStateManager]
[StorySessionService] --> [ResilientChatClient]
[StorySessionService] --> [TurnBasedKnowledgeGraphService] : trigger after completed turn
[StorySessionService] ..> [DerivedMemoryManager] : trigger async refreshes

[PromptAssemblyService] --> [Prompt Builders]
[PromptAssemblyService] --> [HistoryStore]
[PromptAssemblyService] --> [SummaryManager]
[PromptAssemblyService] --> [RecentSummaryManager]
[PromptAssemblyService] --> [CanonicalStateManager]
[PromptAssemblyService] --> [TurnManager]

[TurnManager] --> [AppConfig]
[TurnManager] --> [PromptResourceLoader]
[TurnManager] --> [TurnStateStore]
[TurnManager] --> [TurnState / TurnRuleDecision / GameModeDefinition]

[StoryExportService] --> [HistoryStore]
[StoryExportService] --> MemoryFiles : story-export-*.md

[Prompt Builders] --> [PromptResourceLoader]
[Prompt Builders] --> [PromptTemplateService]
[Prompt Builders] --> [Prompt Input Records]
[PromptResourceLoader] --> SystemPrompts
[PromptTemplateService] --> [PromptResourceLoader]

[SummaryManager] --|> [DerivedMemoryManager]
[RecentSummaryManager] --|> [DerivedMemoryManager]
[CanonicalStateManager] --|> [DerivedMemoryManager]
[DerivedMemoryManager] --> [HistoryStore]
[DerivedMemoryManager] --> [ResilientChatClient]
[DerivedMemoryManager] --> [DerivedMemoryTaskQueue] : submit refresh
[ApplicationFactory] --> [DerivedMemoryTaskQueue] : create
[ApplicationFactory] --> [KnowledgeGraphService]
[ApplicationFactory] --> [TurnBasedKnowledgeGraphService]
[AssistantApp] ..> [DerivedMemoryTaskQueue] : close via context

[HistoryStore] --> MemoryFiles : history.json
[TurnStateStore] --> MemoryFiles : turn-state.json
[SummaryManager] --> MemoryFiles : summary.md
[RecentSummaryManager] --> MemoryFiles : recent-summary.md
[CanonicalStateManager] --> MemoryFiles : canonical-state.yaml
[KnowledgeGraphStore] --> MemoryFiles : knowledge-graph.json

[ReadOnlyKnowledgeGraphService] ..|> [KnowledgeGraphService]
[ReadOnlyKnowledgeGraphService] --> [KnowledgeGraphSnapshot]
[ReadOnlyKnowledgeGraphService] --> [PredicateCatalog]
[KnowledgeGraphInitializer] --> [KnowledgeGraphStore]
[KnowledgeGraphFillService] --> [KnowledgeGraphGenerator]
[KnowledgeGraphGenerator] --> [KnowledgeGraphStore]
[KnowledgeGraphGenerator] --> [ResilientChatClient]
[KnowledgeGraphManagementService] --> [KnowledgeGraphStore] : remove TURNBASED only
[TurnBasedKnowledgeGraphService] --> [HistoryStore] : latest configured turn batch
[TurnBasedKnowledgeGraphService] --> [ResilientChatClient] : extract candidate
[TurnBasedKnowledgeGraphService] --> [DerivedMemoryTaskQueue] : sequential background task
[TurnBasedKnowledgeGraphService] --> [KnowledgeGraphStore] : protected atomic merge
[KnowledgeGraphStore] --> [KnowledgeGraphValidator]
[KnowledgeGraphStore] --> [Graph Entities / Facts / Sources]

[ResponseGuard] --> [ValidationClient]
[ResponseGuard] --> [ValidationDecisionParser]
[ResponseGuard] --> [ResponseSanitizer]
[ValidationClient] --> [ResilientChatClient]
[ValidationDecisionParser] --> [ValidationOutcome]

[ResilientChatClient] --> [LlmBackendGuard]
[ResilientChatClient] --> [OpenAiCompatibleHttpClient]
[ClipboardImageReader] ..> [OpenAiCompatibleHttpClient] : transient base64 image\nvia story request
[ManagedLlamaServer] --> [OpenAiCompatibleHttpClient] : loopback HTTP
[ManagedLlamaServer] --> GgufModel : load
[ManagedMlxServer] --> [OpenAiCompatibleHttpClient] : loopback HTTP
[ManagedMlxServer] --> MlxModel : load

[HistoryStore] --> [Message / HistoryState]
[ValidationClient] --> [Message / HistoryState]

note right of SystemPrompts
Bundled defaults and optional overrides:
- application.config
- systemprompt.md
- rules.md
- fixed_protagonists.yml
- summary and validation prompt files
end note

note right of MemoryFiles
Runtime story state:
- history.json
- turn-state.json
- summary.md
- recent-summary.md
- canonical-state.yaml
- story-export-*.md
- knowledge-graph.json
end note

note bottom of [PromptAssemblyService]
Foreground prompt stack:
- system prompt
- fixed protagonists
- canonical state
- summaries
- recent history
- optional turn-rule instruction
- authoritative and lower-confidence graph facts
end note

note bottom of [ClipboardImageReader]
Reads a copied image from the desktop clipboard.
The base64 data URL exists only in the current request;
history persists only instruction and response text.
end note

note bottom of [TurnManager]
Optional engine-level game rule support:
- initializes round tracking on trigger word
- tracks protagonist participation per round
- injects penalty instructions for illegal extra moves
end note

note bottom of [DerivedMemoryTaskQueue]
Asynchronous after-turn processing:
- one shared single-threaded worker
- summary, recent summary, canonical state,
  and turn-based graph updates
- sequential LLM backend calls
- off the foreground turn path
end note

note bottom of [LlmBackendGuard]
Cooldown-based fail-fast behavior:
- repeated failures open the guard temporarily
- the next call after cooldown acts as the recovery probe
end note

@enduml
