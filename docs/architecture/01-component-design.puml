@startuml
title Component Design - Storyteller

left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho

package "CLI" {
  [AssistantApp]
}

package "Configuration" {
  [AppConfigLoader]
  [AppConfigSource]
  [AppConfig]
}

package "Session Flow" {
  [StorySessionService]
  [PromptAssemblyService]
  [ResponseGuard]
}

package "Prompts & Validation" {
  [PromptResourceLoader]
  [PromptTemplateService]
  [StoryChatPromptBuilder]
  [ValidationPromptBuilder]
  [SummaryPromptBuilder]
  [RecentSummaryPromptBuilder]
  [CanonicalStatePromptBuilder]
  [ValidationClient]
  [ValidationDecisionParser]
  [ResponseSanitizer]
}

package "Model" {
  [Message]
  [HistoryState]
  [ValidationOutcome]
  [StoryChatPromptInput]
  [ValidationPromptInput]
  [SummaryPromptInput]
  [RecentSummaryPromptInput]
  [CanonicalStatePromptInput]
}

package "Memory" {
  [DerivedMemoryManager]
  [HistoryStore]
  [SummaryManager]
  [RecentSummaryManager]
  [CanonicalStateManager]
}

package "Model Access" {
  [LMStudioClient]
}

package "Filesystem" {
  [systemprompts/]
  [memory/]
}

[AssistantApp] --> [AppConfigLoader]
[AssistantApp] --> [StorySessionService]
[AssistantApp] --> [SummaryManager] : shutdown
[AssistantApp] --> [RecentSummaryManager] : shutdown
[AssistantApp] --> [CanonicalStateManager] : shutdown

[AppConfigLoader] --> [AppConfigSource]
[AppConfigLoader] --> [AppConfig]
[AppConfigLoader] --> [systemprompts/] : reads application.config

[StorySessionService] --> [AppConfig]
[StorySessionService] --> [PromptAssemblyService]
[StorySessionService] --> [HistoryStore]
[StorySessionService] --> [ResponseGuard]
[StorySessionService] --> [SummaryManager]
[StorySessionService] --> [RecentSummaryManager]
[StorySessionService] --> [CanonicalStateManager]
[StorySessionService] --> [LMStudioClient]

[PromptAssemblyService] --> [HistoryStore]
[PromptAssemblyService] --> [SummaryManager]
[PromptAssemblyService] --> [RecentSummaryManager]
[PromptAssemblyService] --> [CanonicalStateManager]
[PromptAssemblyService] --> [StoryChatPromptBuilder]
[PromptAssemblyService] --> [ValidationPromptBuilder]
[PromptAssemblyService] --> [StoryChatPromptInput]
[PromptAssemblyService] --> [ValidationPromptInput]

[PromptResourceLoader] --> [systemprompts/]
[PromptTemplateService] --> [PromptResourceLoader]
[StoryChatPromptBuilder] --> [PromptResourceLoader]
[StoryChatPromptBuilder] --> [PromptTemplateService]
[StoryChatPromptBuilder] --> [StoryChatPromptInput]
[ValidationPromptBuilder] --> [PromptResourceLoader]
[ValidationPromptBuilder] --> [PromptTemplateService]
[ValidationPromptBuilder] --> [ValidationPromptInput]
[SummaryPromptBuilder] --> [PromptResourceLoader]
[SummaryPromptBuilder] --> [PromptTemplateService]
[SummaryPromptBuilder] --> [SummaryPromptInput]
[RecentSummaryPromptBuilder] --> [PromptResourceLoader]
[RecentSummaryPromptBuilder] --> [PromptTemplateService]
[RecentSummaryPromptBuilder] --> [RecentSummaryPromptInput]
[CanonicalStatePromptBuilder] --> [PromptResourceLoader]
[CanonicalStatePromptBuilder] --> [PromptTemplateService]
[CanonicalStatePromptBuilder] --> [CanonicalStatePromptInput]
[HistoryStore] --> [memory/] : history
[HistoryStore] --> [HistoryState]
[HistoryStore] --> [Message]
[DerivedMemoryManager] --> [HistoryStore]
[DerivedMemoryManager] --> [LMStudioClient]
[DerivedMemoryManager] --> [HistoryState]
[DerivedMemoryManager] --> [Message]
[PromptAssemblyService] --> [Message]
[ValidationClient] --> [Message]
[SummaryManager] --> [memory/] : summary
[RecentSummaryManager] --> [memory/] : recent summary
[CanonicalStateManager] --> [memory/] : canonical state
[SummaryManager] --> [SummaryPromptBuilder]
[SummaryManager] --> [SummaryPromptInput]
[RecentSummaryManager] --> [RecentSummaryPromptBuilder]
[RecentSummaryManager] --> [RecentSummaryPromptInput]
[CanonicalStateManager] --> [CanonicalStatePromptBuilder]
[CanonicalStateManager] --> [CanonicalStatePromptInput]

[SummaryManager] --|> [DerivedMemoryManager]
[RecentSummaryManager] --|> [DerivedMemoryManager]
[CanonicalStateManager] --|> [DerivedMemoryManager]

[ResponseGuard] --> [ValidationClient]
[ResponseGuard] --> [ValidationDecisionParser]
[ResponseGuard] --> [ValidationOutcome]
[ResponseGuard] --> [ResponseSanitizer]
[ValidationClient] --> [LMStudioClient]
[ValidationDecisionParser] --> [ValidationOutcome]

note bottom of [systemprompts/]
Contains bundled defaults and optional local overrides:
- application.config
- prompt markdown files
- fixed protagonists YAML
end note

note bottom of [memory/]
Runtime story state:
- history.json
- summary.md
- recent-summary.md
- canonical-state.yaml
end note

@enduml
