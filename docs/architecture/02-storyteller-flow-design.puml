@startuml
title Storyteller Flow Design

start

:CLI AssistantApp starts and creates the core runtime context;

if (managed llama-server selected?) then (yes)
  :Start llama-server with the configured GGUF model;
  :Wait for its loopback health endpoint;
else (no)
  if (managed mlx-vlm server selected?) then (yes)
    :Start mlx_vlm.server with the configured MLX model;
    :Wait for its loopback health endpoint;
  else (no)
    :Use the configured OpenAI-compatible endpoint;
  endif
endif

:Read user input;

if (/exit or /quit?) then (yes)
  stop
else (no)

  if (Ctrl-U undo-and-retry?) then (yes)
    :Remove last persisted turn from history;
    :Clamp derived-memory cursors;
    :Send transient reset request;
    :Restore last user prompt in input buffer;
    stop
  else (no)

    if (/export?) then (yes)
      :Load history;
      :Create Markdown export;
      :Print export confirmation;
      stop
    else (no)

      :Delegate the turn to StorySessionService;

      if (turn-based mode enabled?) then (yes)
        if (start trigger?) then (yes)
          :Initialize or reset turn-state;
        else (no)
          :Evaluate actor scope and round participation;
          if (illegal extra move?) then (yes)
            :Prepare engine-side penalty instruction;
          endif
        endif
      endif

      :Assemble prompt stack;
      note right
      Prompt stack contains:
      - one first system message with:
        system prompt
        fixed protagonists
        canonical state
        summaries
      - recent history
      - optional turn-rule instruction
      end note

      :Send chat request through resilience guard
      and shared OpenAI-compatible client;
      :Receive draft response;

      if (validation enabled?) then (yes)
        :Build validation request;
        :Send validator request through validation guard;

        if (validator returns ALLOW?) then (yes)
          :Use sanitized draft response;
        else (no)
          :Use sanitized replacement response;
        endif
      else (no)
        :Use draft response;
      endif

      :Append turn to history;
      :Persist turn-state if active;

      if (Cache-buster interval reached?) then (yes)
        :Send silent reset-with-cache-buster request;
      endif

      :Print final response;

      :Queue canonical state refresh;
      :Queue recent summary refresh;
      :Queue long-term summary refresh;

      note right
      Background updates run asynchronously on one
      shared single-threaded queue. They execute
      sequentially and do not block the foreground response.
      end note

    endif
  endif
endif

stop
@enduml
