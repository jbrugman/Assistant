@startuml
title Storyteller Flow Design

start

:CLI AssistantApp starts and creates the core runtime context;

note right
Version 1.2.0 includes the active core.graph runtime slice:
validated JSON persistence, immutable snapshots,
automatic loading, graph CLI control commands,
and bounded prompt grounding.
end note

if (managed llama-server selected?) then (yes)
  :Start llama-server with the configured GGUF model;
  :Wait for its loopback health endpoint;
else (no)
  if (managed mlx-vlm server selected?) then (yes)
    :Start mlx_vlm.server with the configured MLX model;
    :Wait for its loopback health endpoint;
  else (no)
    :Use the configured OpenAI-compatible endpoint;
  endif
endif

:Load and validate knowledge-graph.json when present;
:Publish immutable graph snapshot;

:Read user input;

if (/exit or /quit?) then (yes)
  stop
else (no)

  if (Ctrl-U undo-and-retry?) then (yes)
    :Remove last persisted turn from history;
    :Clamp derived-memory cursors;
    :Send transient reset request;
    :Restore last user prompt in input buffer;
    stop
  else (no)

    if (graph control command?) then (yes)
      if (/graph?) then (yes)
        :Display current graph locally;
      else (no)
        if (/graph -generate?) then (yes)
          :Create minimal empty graph document locally;
          :Validate and atomically persist graph;
          :Publish empty immutable snapshot;
        else (/graph -fill)
          :Load only fixed_protagonists.yml;
          :Ask model for closed-ontology graph JSON;
          :Normalize schema, revision, provenance,
          status, and hardness in Java;
          if (candidate graph valid?) then (yes)
            :Atomically persist graph;
            :Publish new immutable snapshot;
          else (no)
            :Retain persisted graph and active snapshot;
            :Print graph fill error;
          endif
        endif
      endif
      stop
    else (no)

    if (/image with instruction?) then (yes)
      :Read image from desktop clipboard;
      :Encode image as a transient PNG data URL;
      :Build multimodal user message with text and image;
      :Send request through resilience guard
      and shared OpenAI-compatible client;
      :Validate response using text only;
      :Persist only instruction and response text;
      :Queue derived-memory refreshes using text history only;
      :Print final response;
      stop
    else (no)

    if (/export?) then (yes)
      :Load history;
      :Create Markdown export;
      :Print export confirmation;
      stop
    else (no)

      :Delegate the turn to StorySessionService;

      if (turn-based mode enabled?) then (yes)
        if (start trigger?) then (yes)
          :Initialize or reset turn-state;
        else (no)
          :Evaluate actor scope and round participation;
          if (illegal extra move?) then (yes)
            :Prepare engine-side penalty instruction;
          endif
        endif
      endif

      :Automatically reload graph file when available;
      :Resolve entities mentioned by name or alias;
      :Select bounded active hard facts;
      :Assemble prompt stack;
      note right
      Prompt stack contains:
      - one first system message with:
        system prompt
        fixed protagonists
        canonical state
        summaries
        relevant graph facts
      - recent history
      - optional turn-rule instruction
      end note

      :Send chat request through resilience guard
      and shared OpenAI-compatible client;
      :Receive draft response;

      if (validation enabled?) then (yes)
        :Resolve relevant active hard facts
        from user input and draft;
        :Build validation request with graph facts;
        :Send validator request through validation guard;

        if (validator returns ALLOW?) then (yes)
          :Use sanitized draft response;
        else (no)
          :Use sanitized replacement response;
        endif
      else (no)
        :Use draft response;
      endif

      :Append turn to history;
      :Persist turn-state if active;

      if (Cache-buster interval reached?) then (yes)
        :Send silent reset-with-cache-buster request;
      endif

      :Print final response;

      :Queue canonical state refresh;
      :Queue recent summary refresh;
      :Queue long-term summary refresh;

      note right
      Background updates run asynchronously on one
      shared single-threaded queue. They execute
      sequentially and do not block the foreground response.
      end note

    endif
    endif
    endif
  endif
endif

stop
@enduml
