@startuml
title Storyteller Knowledge Graph Flow

start
:Load knowledge-graph.json when present;
:Validate document;
:Publish immutable snapshot;

if (graph command?) then (yes)
  if (/graph?) then (yes)
    :Display current snapshot and file path locally;
  else (no)
    if (/graph -generate?) then (yes)
      :Create minimal empty graph;
      :Validate and atomically persist;
      :Publish empty snapshot;
    else (no)
      if (/graph -fill?) then (yes)
        :Load only fixed_protagonists.yml;
        :Request closed-ontology JSON from model;
        :Normalize entities and facts to
        FIXED_PROTAGONIST and hard facts;
        if (valid candidate?) then (yes)
          :Atomically replace graph file;
          :Publish new snapshot;
        else (no)
          :Keep persisted graph and active snapshot;
          :Report fill error;
        endif
      else (/graph -reset)
        :Remove only TURNBASED entities and facts;
        :Preserve fixed, manual and other sources;
        :Atomically persist and publish snapshot;
      endif
    endif
  endif
else (story or validation prompt)
  :Automatically load current graph file;
  if (file valid?) then (yes)
    :Publish current snapshot;
  else (no)
    :Keep last valid snapshot;
  endif
  :Resolve mentioned names and aliases;
  :Select bounded ACTIVE facts;
  :Label hard facts authoritative;
  :Label TURNBASED facts lower confidence;
  :Inject authority-aware facts into generation
  or validation prompt;
  if (completed turn count reaches configured batch?) then (yes)
    :Queue latest complete turn batch;
    :Extract closed-ontology candidate through model;
    :Normalize all candidate items to TURNBASED;
    :Force generated facts to ACTIVE and hard=false;
    :Protect non-TURNBASED entities and facts;
    :Atomically merge and publish snapshot;
  endif
endif

stop
@enduml
