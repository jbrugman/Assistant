lmstudio.url=http://localhost:1234/v1/chat/completions

# Example model IDs as returned by http://localhost:1234/v1/models
# model.chat=google/gemma-4-26b-a4b-qat
# model.validator=google/gemma-4-26b-a4b-qat

# uses the default loaded model.
model.chat=
model.validator=

file.systemPrompt=systemprompts/systemprompt.md
file.rules=systemprompts/rules.md
file.fixedProtagonists=systemprompts/fixed_protagonists.yml
file.fixedProtagonistsContext=systemprompts/fixedprotagonistscontext.md
file.summarySystemPrompt=systemprompts/summarysystemprompt.md
file.summaryContext=systemprompts/summarycontext.md
file.summary=memory/summary.md
file.recentSummarySystemPrompt=systemprompts/recentsummarysystemprompt.md
file.recentSummaryContext=systemprompts/recentsummarycontext.md
file.recentSummary=memory/recent-summary.md
file.canonicalStateSystemPrompt=systemprompts/canonicalstatesystemprompt.md
file.canonicalStateContext=systemprompts/canonicalstatecontext.md
file.validationSystemPrompt=systemprompts/validationsystemprompt.md
file.validationRequestTemplate=systemprompts/validationrequesttemplate.md
file.turnViolationSingleTemplate=systemprompts/turnviolationsingletemplate.md
file.turnViolationPartyTemplate=systemprompts/turnviolationpartytemplate.md
file.canonicalState=memory/canonical-state.yaml
file.history=memory/history.json
file.legacyHistory=memory/history.md
file.turnState=memory/turn-state.json
file.resetCacheBusterTemplate=systemprompts/resetcachebuster.md

chat.maxRecentTurns=2
recentSummary.maxRecentTurns=12
chat.temperature=0.6
chat.topK=40
chat.topP=0.9
chat.minP=0.05
chat.repeatPenalty=1.1

summary.batchMessages=10
recentSummary.batchMessages=6
canonicalState.batchMessages=2
cacheBuster.interval=5
summary.temperature=0.2
summary.topP=0.9

game.turnBasedModeEnabled=false
game.turnPenaltySingleLowHp=5
game.turnPenaltySingleHighHp=10

validation.temperature=0.0
validation.topP=0.1
validation.enabled=true

timeout.chatSeconds=350
timeout.summarySeconds=350
timeout.validationSeconds=180

resilience.chat.failureThreshold=3
resilience.chat.cooldownSeconds=20
resilience.validation.failureThreshold=2
resilience.validation.cooldownSeconds=15
resilience.background.failureThreshold=2
resilience.background.cooldownSeconds=60

response.hideReasoningBlocks=true
response.validationFailClosedMessage=The story drifted away from the rules. Try again with a cleaner prompt.

command.continueStory=(continue the story)
command.resetStory=(reset your behavior; strictly follow the system prompt, fixed protagonists, and rules from now on)
ui.bannerStart=Storyteller started.
ui.commandHelp=Use /exit or /quit to leave. Use /export for markdown export, /export -intro for italicized prompts, /export -clean for story-only output, or /export -all for full chronological prompt and story export.
ui.shortcutContinueHint=Press Ctrl-G to send '(continue the story)'.
ui.shortcutResetHint=Press Ctrl-W to send a reset instruction if the model starts drifting.
ui.shortcutUndoHint=Press Ctrl-U to remove the last turn, send a reset instruction, and restore your last prompt for editing.
ui.shortcutLastTurnHint=Press Ctrl-L to show the last persisted prompt and reply without sending anything to the model.
ui.resetSent=Reset instruction sent. Re-checking the active rules now.
ui.undoSent=Undo command sent. Removing the last turn and sending a reset instruction now.
ui.noStoryTurnToUndo=No story turn available to undo.
ui.undoRestored=The removed prompt has been restored in the input buffer for editing.
ui.noLastTurn=No persisted story turn available yet.
ui.lastTurnTemplate=Last persisted turn\n\nUser:\n%s\n\nAssistant:\n%s
ui.macHint=On macOS, Cmd key combinations only work if your terminal forwards them. If you are using iTerm2, go to Preferences > Keys > Key Mappings and check "Left option acts as +Esc" and "Right option acts as +Esc".
ui.errorLmStudioRequest=LM Studio request error
ui.errorProcessHistory=Error processing history or response
